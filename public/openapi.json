{
  "openapi": "3.0.3",
  "info": {
    "title": "Grima Telemetry API",
    "description": "Real-time Wi-Fi status, connected devices with automatic class detection (phone/laptop/tv/iot), on-demand speed test, and network telemetry API for clients, LLMs, and autonomous agents.",
    "version": "0.4.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Local / Tailscale Grima Server"
    }
  ],
  "paths": {
    "/api/status": {
      "get": {
        "summary": "Get full network telemetry snapshot",
        "description": "Returns complete aggregated network telemetry: summary counts, active devices, Wi-Fi spectrum, router gateway status, latest speed test, latencies, and host stats.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/speedtest": {
      "post": {
        "summary": "Perform on-demand speed test",
        "description": "Triggers an active network benchmark measuring edge ping/jitter, download throughput (Mbps), and upload throughput (Mbps) against nearest Cloudflare Edge.",
        "responses": {
          "200": {
            "description": "Speed test completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpeedTestResult"
                }
              }
            }
          },
          "429": {
            "description": "Speed test already in progress"
          }
        }
      },
      "get": {
        "summary": "Get latest speed test result",
        "description": "Returns the most recently recorded speed test result, or executes a new test if none has run yet.",
        "responses": {
          "200": {
            "description": "Latest speed test benchmark",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpeedTestResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices": {
      "get": {
        "summary": "Get connected devices inventory",
        "description": "Returns active devices discovered on the local subnet (/24) including IP, MAC, hardware manufacturer (IEEE OUI), friendly name, medium (Wi-Fi/Ethernet), automatic device class (phone/laptop/tv/iot/router/server), and ping latency.",
        "responses": {
          "200": {
            "description": "List of active network devices",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevicesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/wifi": {
      "get": {
        "summary": "Get Wi-Fi spectrum and visible networks",
        "description": "Returns dual-band Wi-Fi radio scan data: SSIDs, BSSIDs, signal percent and dBm, carrier frequency, channel, security mode, and bitrates.",
        "responses": {
          "200": {
            "description": "Wi-Fi radio status and scan list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WifiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/router": {
      "get": {
        "summary": "Get router & WAN gateway status",
        "description": "Queries the local router gateway via UPnP IGD: model name, external public WAN IP, system uptime, and connection error status.",
        "responses": {
          "200": {
            "description": "Router gateway telemetry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouterResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/shelly": {
      "get": {
        "summary": "Get Shelly Presence sensor full state",
        "description": "Returns the complete bridge state for the local Shelly Presence Gen4 mmWave sensor: device identity (model, MAC, firmware), online status, live presence zone state (detected + object count), ambient illuminance level, zone configuration, and a recent event log of state changes.",
        "responses": {
          "200": {
            "description": "Shelly Presence bridge state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShellyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/presence": {
      "get": {
        "summary": "Get lightweight room presence state",
        "description": "Minimal, app-friendly endpoint exposing the live mmWave presence detection result from the Shelly Presence Gen4: whether someone is present in the monitored zone, how many objects are detected, and when the state last changed. Ideal for other apps and automations.",
        "responses": {
          "200": {
            "description": "Presence summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresenceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/stream": {
      "get": {
        "summary": "Live unified event stream (SSE)",
        "description": "Server-Sent Events stream combining all Grima sources: Shelly sensor events (presence_detected, presence_cleared, illuminance_changed, device_online/offline) and LAN device transitions (device_connected, device_disconnected from router ARP scans). Sends an initial `connected` snapshot event with current presence state and recent history, then pushes events in real time. A comment-line heartbeat is sent every 25s to keep proxies alive.",
        "responses": {
          "200": {
            "description": "SSE stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/GrimaEvent"
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "summary": "Get recent unified event history",
        "description": "Returns the last 200 published events (newest first) from both sources: Shelly sensor state changes and LAN device connect/disconnect transitions. Useful for clients that cannot hold a persistent SSE connection.",
        "responses": {
          "200": {
            "description": "Event history",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer" },
                    "events": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/GrimaEvent" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/version": {
      "get": {
        "summary": "Get Grima version and metadata",
        "responses": {
          "200": {
            "description": "Daemon version info"
          }
        }
      }
    },
    "/api/scan": {
      "post": {
        "summary": "Trigger immediate fresh network scan",
        "description": "Invalidates cache and initiates immediate active subnet ARP sweep and Wi-Fi spectrum scan.",
        "responses": {
          "200": {
            "description": "Scan complete notification with fresh telemetry data"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SpeedTestResult": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "server": { "type": "string", "example": "Cloudflare Edge (WAW)" },
          "pingMs": { "type": "number", "example": 5.2 },
          "minPingMs": { "type": "number", "example": 4.8 },
          "jitterMs": { "type": "number", "example": 0.4 },
          "downloadMbps": { "type": "number", "example": 509.21 },
          "downloadDurationSec": { "type": "number", "example": 0.55 },
          "uploadMbps": { "type": "number", "example": 181.99 },
          "uploadDurationSec": { "type": "number", "example": 0.23 },
          "totalBytesTransferred": { "type": "integer", "example": 40242880 },
          "totalDurationSeconds": { "type": "number", "example": 1.3 },
          "status": { "type": "string", "example": "success" }
        }
      },
      "StatusResponse": {
        "type": "object",
        "properties": {
          "app": { "type": "string", "example": "grima" },
          "version": { "type": "string", "example": "0.3.0" },
          "documentation": {
            "type": "object",
            "properties": {
              "docsUrl": { "type": "string", "example": "/docs" },
              "openapiUrl": { "type": "string", "example": "/docs/openapi.json" },
              "llmsTxtUrl": { "type": "string", "example": "/llms.txt" }
            }
          },
          "timestamp": { "type": "string", "format": "date-time" },
          "lastSpeedTest": { "$ref": "#/components/schemas/SpeedTestResult" },
          "shelly": { "$ref": "#/components/schemas/PresenceResponse" },
          "summary": { "type": "object" },
          "devices": { "type": "array", "items": { "$ref": "#/components/schemas/Device" } },
          "wifi": { "$ref": "#/components/schemas/WifiResponse" },
          "router": { "$ref": "#/components/schemas/RouterResponse" }
        }
      },
      "Device": {
        "type": "object",
        "properties": {
          "ip": { "type": "string", "example": "192.168.1.102" },
          "mac": { "type": "string", "example": "70:3e:97:7e:e6:e2" },
          "name": { "type": "string", "example": "Pendrive Mi TV (Xiaomi Mi TV Stick)" },
          "vendor": { "type": "string", "example": "Xiaomi (Iton Tech)" },
          "type": { "type": "string", "example": "Smart TV / Streaming" },
          "medium": { "type": "string", "enum": ["Wi-Fi", "Wired Ethernet (enp1s0)", "Router / AP"] },
          "deviceClass": {
            "type": "string",
            "description": "Automatic device classification derived from MAC randomization detection, IEEE OUI vendor signature, mDNS/DNS-SD service discovery, and SSH port probing.",
            "enum": ["phone", "laptop", "tv", "iot", "router", "server", "unknown"],
            "example": "phone"
          },
          "macRandomized": {
            "type": "boolean",
            "description": "True when the MAC is locally administered (randomized) — typical of iOS/Android Wi-Fi privacy.",
            "example": true
          },
          "classReason": { "type": "string", "example": "Randomized (locally administered) MAC — iOS/Android Wi-Fi privacy" },
          "latencyMs": { "type": "number", "nullable": true, "example": 1.2 },
          "state": { "type": "string", "example": "REACHABLE" },
          "isRouter": { "type": "boolean" },
          "isLocalHost": { "type": "boolean" }
        }
      },
      "DevicesResponse": {
        "type": "object",
        "properties": {
          "count": { "type": "integer" },
          "wifiCount": { "type": "integer" },
          "wiredCount": { "type": "integer" },
          "deviceClassCounts": {
            "type": "object",
            "description": "Client devices grouped by detected class (router and local host excluded).",
            "additionalProperties": { "type": "integer" },
            "example": { "phone": 1, "laptop": 1, "iot": 2 }
          },
          "devices": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Device" }
          }
        }
      },
      "WifiResponse": {
        "type": "object",
        "properties": {
          "interface": { "type": "string", "example": "wlp0s12f0" },
          "state": { "type": "string", "example": "Hardware Available (Dual-band)" },
          "localAccessPoints": { "type": "array", "items": { "$ref": "#/components/schemas/WifiNetwork" } },
          "allVisibleNetworks": { "type": "array", "items": { "$ref": "#/components/schemas/WifiNetwork" } }
        }
      },
      "WifiNetwork": {
        "type": "object",
        "properties": {
          "ssid": { "type": "string", "example": "Sebastiana_20" },
          "bssid": { "type": "string", "example": "08:8A:F1:5E:5D:BC" },
          "channel": { "type": "string", "example": "4" },
          "frequency": { "type": "string", "example": "2427 MHz" },
          "signalPercent": { "type": "integer", "example": 100 },
          "signalDbm": { "type": "integer", "example": -50 },
          "security": { "type": "string", "example": "WPA2" },
          "rate": { "type": "string", "example": "270 Mbit/s" },
          "isLocalAp": { "type": "boolean" }
        }
      },
      "RouterResponse": {
        "type": "object",
        "properties": {
          "model": { "type": "string", "example": "MERCUSYS AC12G AC1300 Wireless Dual Band Gigabit Router" },
          "gatewayIp": { "type": "string", "example": "192.168.1.1" },
          "externalIp": { "type": "string", "example": "176.115.2.218" },
          "uptimeSeconds": { "type": "integer", "example": 1082000 },
          "uptimeFormatted": { "type": "string", "example": "12d 12h 33m" },
          "connectionStatus": { "type": "string", "example": "Connected" },
          "lastError": { "type": "string", "example": "ERROR_NONE" }
        }
      },
      "PresenceResponse": {
        "type": "object",
        "description": "Live mmWave presence state from the Shelly Presence Gen4 sensor.",
        "properties": {
          "present": { "type": "boolean", "description": "True when a person/object is detected in the monitored zone.", "example": true },
          "numObjects": { "type": "integer", "description": "Number of objects detected by the mmWave radar.", "example": 1 },
          "zoneName": { "type": "string", "example": "Room" },
          "presentSince": { "type": "string", "format": "date-time", "nullable": true, "description": "When presence last became true; null when nobody is present." },
          "updatedAt": { "type": "string", "format": "date-time" },
          "online": { "type": "boolean", "description": "Whether the Shelly device is reachable.", "example": true },
          "device": { "type": "string", "nullable": true, "example": "S4SN-0U61X" },
          "ip": { "type": "string", "example": "192.168.1.102" }
        }
      },
      "GrimaEvent": {
        "type": "object",
        "description": "A single event from the unified Grima event stream (SSE /api/events/stream or REST /api/events).",
        "properties": {
          "ts": { "type": "string", "format": "date-time" },
          "source": {
            "type": "string",
            "enum": ["shelly", "network", "grima"],
            "description": "shelly = Shelly Presence sensor events; network = LAN device connect/disconnect transitions; grima = stream lifecycle."
          },
          "type": {
            "type": "string",
            "description": "Event type: presence_detected, presence_cleared, illuminance_changed, device_online, device_offline, track (shelly) or device_connected, device_disconnected (network).",
            "example": "presence_detected"
          },
          "detail": {
            "type": "object",
            "description": "Event-specific payload. Shelly events include zone/numObjects/device; network events include ip, mac, name, vendor, deviceClass, medium.",
            "example": { "present": true, "numObjects": 1, "zone": "Room", "device": "S4SN-0U61X" }
          }
        }
      },
      "ShellyResponse": {
        "type": "object",
        "description": "Full Shelly Presence bridge state including device identity, sensor data, and event log.",
        "properties": {
          "source": { "type": "string", "example": "shelly-presence" },
          "device": {
            "type": "object",
            "properties": {
              "ip": { "type": "string", "example": "192.168.1.102" },
              "mac": { "type": "string", "example": "58E6C50D46E0" },
              "model": { "type": "string", "example": "S4SN-0U61X" },
              "gen": { "type": "integer", "example": 4 },
              "firmware": { "type": "string", "example": "1.8.99-presenceg4prod1" },
              "app": { "type": "string", "example": "PresenceG4" },
              "matter": { "type": "boolean", "example": true }
            }
          },
          "online": { "type": "boolean" },
          "lastSeen": { "type": "string", "format": "date-time", "nullable": true },
          "realtimeChannel": { "type": "string", "enum": ["websocket", "polling"], "description": "How fresh the data is: websocket when the live event channel is connected, otherwise polling." },
          "presence": {
            "type": "object",
            "properties": {
              "present": { "type": "boolean" },
              "numObjects": { "type": "integer" },
              "zoneId": { "type": ["integer", "null"] },
              "zoneName": { "type": "string" },
              "presentSince": { "type": "string", "format": "date-time", "nullable": true },
              "updatedAt": { "type": "string", "format": "date-time", "nullable": true }
            }
          },
          "illuminance": {
            "type": "object",
            "properties": {
              "level": { "type": ["string", "null"], "enum": ["dark", "bright", null] },
              "updatedAt": { "type": "string", "format": "date-time", "nullable": true }
            }
          },
          "zoneConfig": {
            "type": "object",
            "properties": {
              "zmin": { "type": ["number", "null"], "description": "Minimum monitored distance (m)" },
              "zmax": { "type": ["number", "null"], "description": "Maximum monitored distance (m)" },
              "sensitivity": { "type": ["string", "null"] },
              "mainZone": { "type": ["string", "null"] }
            }
          },
          "events": {
            "type": "array",
            "description": "Most recent state-change events, newest first (capped at 50 in API responses).",
            "items": {
              "type": "object",
              "properties": {
                "ts": { "type": "string", "format": "date-time" },
                "type": { "type": "string", "example": "presence_detected" },
                "detail": { "type": "object" }
              }
            }
          }
        }
      }
    }
  }
}
